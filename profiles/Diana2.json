{
  "glider": "Diana 2",
  "vjoyDevice": 1,
  "zoneRadius": 0.10,
  "pinchGrab": 0.5,
  "pinchRelease": 0.25,
  "controllerStickTravel": 0.10,
  "controllerRudderAngle": 30,
  "autorudderKey": "A",
  "autorudderOn": false,
  "controls": [
    {
      "name": "stick",
      "type": "stick",
      "say": "stick",
      "hand": "right",
      "fromPrompt": "stick centred",
      "toPrompt": "stick fully forward",
      "rightPrompt": "stick fully right",
      "from": null,
      "to": null,
      "right": null,
      "vjoyAxis": "RY",
      "vjoyRange": [1, 0],
      "vjoyRollAxis": "RX",
      "vjoyRollRange": [0, 1],
      "vjoyRudderAxis": "RZ",
      "vjoyRudderRange": [0, 1]
    },
    {
      "name": "airbrake",
      "type": "lever",
      "say": "airbrake",
      "hand": "left",
      "fromPrompt": "airbrake closed",
      "toPrompt": "airbrake fully open",
      "from": null,
      "to": null,
      "vjoyAxis": "X",
      "initial": 0,
      "feedback": "announce",
      "announce": "brakes",
      "announceEnds": ["closed", "full"],
      "announceEvery": 8
    },
    {
      "name": "flaps",
      "type": "lever",
      "say": "flaps",
      "hand": "left",
      "fromPrompt": "flaps at 28",
      "toPrompt": "flaps at minus 2",
      "from": null,
      "to": null,
      "vjoyAxis": "Y",
      "vjoyRange": [1, 0],
      "detents": ["flaps 28", "flaps 21", "flaps 14", "flaps 8", "flaps 3", "flaps zero", "flaps minus 2"],
      "initial": 5
    },
    {
      "name": "trim",
      "type": "lever",
      "say": "trim",
      "hand": "left",
      "fromPrompt": "trim fully forward",
      "toPrompt": "trim fully back",
      "from": null,
      "to": null,
      "vjoyAxis": "Z",
      "initial": 0.5,
      "feedback": "ticks"
    },
    {
      "name": "release",
      "type": "button",
      "say": "release",
      "hand": "left",
      "fromPrompt": "tow release handle",
      "from": null,
      "vjoyButton": 1
    },
    {
      "name": "gear",
      "type": "toggle",
      "say": "gear lever",
      "hand": "left",
      "fromPrompt": "gear lever, one end",
      "toPrompt": "gear lever, other end",
      "from": null,
      "to": null,
      "vjoyButton": 2,
      "initial": 0
    },
    {
      "name": "ballast",
      "type": "toggle",
      "say": "water ballast",
      "hand": "right",
      "fromPrompt": "water ballast valve closed",
      "toPrompt": "water ballast valve open",
      "from": null,
      "to": null,
      "vjoyButton": 3,
      "states": ["ballast closed", "dumping ballast"],
      "initial": 0
    }
  ]
}
